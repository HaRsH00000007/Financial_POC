# Copy these into your shell environment before starting uvicorn (the app does not read .env files).
# Never commit real keys.

# Enables Groq for classification, mapping suggestions, commentary and the assistant.
# Leave unset to run fully offline with the deterministic stand-in.
GROQ_API_KEY=

# Groq model used by the AI layer (must support tool calling). Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Set to 1 to force offline mode even when a key is present
FIW_DISABLE_LLM=0

# Comma-separated CORS origins (only needed if the frontend is not served through the Vite proxy)
FIW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
